{
  "name": "homepage-traefik",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight dashboard that auto-discovers and displays Traefik routes",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=93 --test-coverage-functions=95 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "keywords": [
    "traefik",
    "dashboard",
    "homepage",
    "docker"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
