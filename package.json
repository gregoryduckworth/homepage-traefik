{
  "name": "homepage-traefik",
  "version": "1.0.0",
  "description": "A lightweight dashboard that auto-discovers and displays Traefik routes",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "test:coverage": "node --test --experimental-test-coverage --disable-warning=MODULE_TYPELESS_PACKAGE_JSON",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "keywords": [
    "traefik",
    "dashboard",
    "homepage",
    "docker"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
